# 本地开发模板：可直接 -config config/env.ini.local，也可复制成 config/env.ini
# env_mode 取值：debug / release / test
env_mode = debug
# 提供下载文件的存放路径(留空则默认程序执行的当前目录)
# 可相对路径，如：./download_lib | download_lib
# 可绝对路径，如：E:\download_lib | /tmp/download_lib
download_lib_path = download_lib
# 页面上展示的下载库路径：留空则自动识别容器映射的宿主机目录，识别不到就用上面的真实路径
# 例：D:\download_lib 、 /home/download_lib
# display_lib_path =

[server]
# http协议
protocol = http
# http端口号
http_port = 9801